# Neon development branch — pooled connection (used by the app and the Prisma CLI)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Email verification on sign-up. On unless set to "false".
# Set to "false" while Resend has no verified domain (the default sender only delivers to the Resend account owner).
EMAIL_VERIFICATION_ENABLED="true"
